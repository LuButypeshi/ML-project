def make_mnist_like(n=8000, seed=0):
    """Chiffres 28×28 synthétiques (prototypes + bruit gaussien)."""
    rng = np.random.default_rng(seed)
    K, d = 10, 784
    n_k  = n // K
    protos = []
    for k in range(K):
        p = np.zeros((28, 28))
        c = [14, 14]
        # Chaque chiffre a un motif unique
        if k == 0:
            for i in range(28):
                for j in range(28):
                    if .55 < ((i-14)/9)**2+((j-14)/6)**2 < 1.1: p[i,j]=1
        elif k == 1:
            p[4:24, 12:16] = 1
        elif k == 2:
            p[4:8,4:24]=1; p[4:14,20:24]=1; p[12:16,4:24]=1
            p[16:24,4:8]=1; p[20:24,4:24]=1
        elif k == 3:
            p[4:8,4:24]=1; p[12:16,4:24]=1; p[20:24,4:24]=1
            p[4:24,20:24]=1
        elif k == 4:
            p[4:14,4:8]=1; p[12:16,4:24]=1; p[4:24,20:24]=1
        elif k == 5:
            p[4:8,4:24]=1; p[4:14,4:8]=1; p[12:16,4:24]=1
            p[14:24,20:24]=1; p[20:24,4:24]=1
        elif k == 6:
            p[4:8,4:24]=1; p[4:24,4:8]=1; p[12:16,4:24]=1
            p[14:24,20:24]=1; p[20:24,4:24]=1
        elif k == 7:
            p[4:8,4:24]=1; p[4:24,20:24]=1
        elif k == 8:
            p[4:8,4:24]=1; p[12:16,4:24]=1; p[20:24,4:24]=1
            p[4:24,4:8]=1; p[4:24,20:24]=1
        else:
            p[4:8,4:24]=1; p[4:16,4:8]=1; p[4:16,20:24]=1
            p[12:16,4:24]=1; p[16:24,20:24]=1
        protos.append(p.flatten())
    protos = np.array(protos)
    X = np.vstack([protos[k] + rng.normal(0,.18,(n_k,d)) for k in range(K)])
    y = np.repeat(np.arange(K), n_k)
    X = np.clip(X, 0, 1)
    sh = rng.permutation(len(y)); return X[sh], y[sh]

def make_cifar_like(n=6000, seed=1):
    """Images 32×32×3 synthétiques avec 10 classes de couleur."""
    rng = np.random.default_rng(seed)
    K, n_k = 10, n//10
    hues = np.linspace(0, 1, K, endpoint=False)
    X_list, y_list = [], []
    for k in range(K):
        h = hues[k]
        base = np.zeros((n_k, 3072))
        for c in range(3):
            v = .5 + .4*np.sin(2*np.pi*(h+c/3))
            base[:, c*1024:(c+1)*1024] = np.clip(v + rng.normal(0,.1,(n_k,1024)), 0, 1)
        X_list.append(base); y_list.append(np.full(n_k, k, dtype=int))
    X = np.vstack(X_list); y = np.concatenate(y_list)
    sh = rng.permutation(len(y)); return X[sh], y[sh]

# ─────────────────────────────────────────────────────────────────────────────
#  MODÈLES
# ─────────────────────────────────────────────────────────────────────────────

class ModeleLineaire:
    """
    Modèle linéaire multi-classe (poly ch.3) :
        o = Ax + b,  P = softmax(o)
    Gradient entropie croisée + softmax :
        ∂L/∂A = (1/n)(P−Y)Xᵀ,   ∂L/∂b = (1/n)Σ(P−Y)
    """
    def __init__(self, d=784, K=10):
        rng = np.random.default_rng(0)
        self.A = rng.normal(0, .01, (K, d))
        self.b = np.zeros((K, 1))

    def forward(self, X): return softmax(self.A @ X + self.b)
    def loss(self, X, Y): return cross_entropy(self.forward(X), Y)
    def predict(self, X): return np.argmax(self.forward(X), axis=0)

    def fit(self, X, Y_oh, lr=.1, epochs=150, bs=512, Xv=None, Yv=None):
        n = X.shape[1]; hist = dict(lt=[], lv=[], at=[], av=[])
        for ep in range(epochs):
            idx = np.random.permutation(n)
            for s in range(0, n, bs):
                Xb = X[:, idx[s:s+bs]]; Yb = Y_oh[:, idx[s:s+bs]]
                P  = self.forward(Xb);  d  = P - Yb; nb = Xb.shape[1]
                self.A -= lr * (d @ Xb.T) / nb
                self.b -= lr * d.mean(1, keepdims=True)
            hist['lt'].append(self.loss(X, Y_oh))
            hist['at'].append(accuracy(self.predict(X), np.argmax(Y_oh,0)))
            if Xv is not None:
                hist['lv'].append(self.loss(Xv, Yv))
                hist['av'].append(accuracy(self.predict(Xv), np.argmax(Yv,0)))
            if (ep+1) % 50 == 0:
                print(f"  ép.{ep+1:3d} — loss:{hist['lt'][-1]:.4f}  acc:{hist['at'][-1]:.3f}", end="")
                if Xv is not None: print(f"  val:{hist['av'][-1]:.3f}")
                else: print()
        return hist

class MLP:
    """
    MLP multi-couches (poly ch.4) avec rétropropagation (ch.5).
    layers  : liste de tailles, ex. [784, 256, 128, 10]
    Rétropropagation :
        δ_sortie = P − Y
        dW_l = (1/n) δ_l · z_{l-1}ᵀ
        δ_{l-1} = Wlᵀ δ_l ⊙ φ'(o_{l-1})
    """
    def __init__(self, layers, act="relu"):
        rng = np.random.default_rng(42); self.act = act
        self.W = []; self.b = []
        for i in range(len(layers)-1):
            sc = np.sqrt(2/layers[i])
            self.W.append(rng.normal(0, sc, (layers[i+1], layers[i])))
            self.b.append(np.zeros((layers[i+1], 1)))

    def φ(self, Z):  return relu(Z)  if self.act=="relu" else np.tanh(Z)
    def φp(self, Z): return relu_p(Z) if self.act=="relu" else tanh_p(Z)

    def forward(self, X):
        A = X; pre = []; act = [X]
        for i,(W,b) in enumerate(zip(self.W, self.b)):
            Z = W @ A + b; pre.append(Z)
            A = softmax(Z) if i==len(self.W)-1 else self.φ(Z)
            act.append(A)
        return act[-1], pre, act

    def loss(self, X, Y):    P,_,_ = self.forward(X); return cross_entropy(P,Y)
    def predict(self, X):    P,_,_ = self.forward(X); return np.argmax(P,0)

    def backprop(self, X, Y_oh):
        n = X.shape[1]; P, pre, act = self.forward(X)
        dW = [None]*len(self.W); db = [None]*len(self.b)
        δ  = (P - Y_oh) / n
        for i in reversed(range(len(self.W))):
            dW[i] = δ @ act[i].T; db[i] = δ.sum(1, keepdims=True)
            if i > 0: δ = self.W[i].T @ δ * self.φp(pre[i-1])
        return dW, db

    def fit(self, X, Y_oh, lr=.05, epochs=150, bs=512, Xv=None, Yv=None):
        n = X.shape[1]; hist = dict(lt=[], lv=[], at=[], av=[])
        for ep in range(epochs):
            idx = np.random.permutation(n)
            for s in range(0, n, bs):
                Xb = X[:, idx[s:s+bs]]; Yb = Y_oh[:, idx[s:s+bs]]
                dW, db = self.backprop(Xb, Yb)
                for i in range(len(self.W)):
                    self.W[i] -= lr*dW[i]; self.b[i] -= lr*db[i]
            hist['lt'].append(self.loss(X, Y_oh))
            hist['at'].append(accuracy(self.predict(X), np.argmax(Y_oh,0)))
            if Xv is not None:
                hist['lv'].append(self.loss(Xv, Yv))
                hist['av'].append(accuracy(self.predict(Xv), np.argmax(Yv,0)))
            if (ep+1) % 50 == 0:
                print(f"  ép.{ep+1:3d} — loss:{hist['lt'][-1]:.4f}  acc:{hist['at'][-1]:.3f}", end="")
                if Xv is not None: print(f"  val:{hist['av'][-1]:.3f}")
                else: print()
        return hist

# ─────────────────────────────────────────────────────────────────────────────
#  CNN : briques de base + démonstration
# ─────────────────────────────────────────────────────────────────────────────

def apply_filter_2d(img, K):
    """Convolution 2D avec zero-padding (§2.3 du sujet)."""
    return convolve2d(img, K[::-1,::-1], mode="same", boundary="fill", fillvalue=0)

def conv_forward(vol, filters, biases):
    """Conv 3D : vol (H,W,Cin) × filters (Cout,3,3,Cin) → (H,W,Cout)."""
    H, W, Cin = vol.shape; Cout = len(filters)
    out = np.zeros((H, W, Cout))
    for f in range(Cout):
        for c in range(Cin):
            out[:,:,f] += apply_filter_2d(vol[:,:,c], filters[f,:,:,c])
        out[:,:,f] += biases[f]
    return out

def maxpool(vol):
    """MaxPool 2×2, stride 2 ; renvoie (out, mask)."""
    H, W, C = vol.shape; H2, W2 = H//2, W//2
    out  = np.zeros((H2, W2, C))
    mask = np.zeros((H, W, C), dtype=bool)
    for u in range(H2):
        for v in range(W2):
            blk = vol[2*u:2*u+2, 2*v:2*v+2, :]   # (2,2,C)
            flat = blk.reshape(4, C); idx = np.argmax(flat, 0)
            out[u,v,:] = flat[idx, np.arange(C)]
            for c in range(C):
                r, col = divmod(int(idx[c]), 2)
                mask[2*u+r, 2*v+col, c] = True
    return out, mask

def cnn_forward_single(img, F1, b1, F2, b2, F3, b3, W_d, b_d):
    """
    Forward pass CNN sur une image (32,32,3).
    Architecture (sujet §2.5) :
      Conv1(Cout) + ReLU → Conv2(Cout) + ReLU → Pool →
      Conv3(Cout) + ReLU → Pool → Flatten → Dense(10) → Softmax
    """
    v1 = np.maximum(0, conv_forward(img, F1, b1))
    v2 = np.maximum(0, conv_forward(v1, F2, b2))
    v3, mk3 = maxpool(v2)
    v4 = np.maximum(0, conv_forward(v3, F3, b3))
    v5, mk5 = maxpool(v4)
    flat = v5.flatten()[:,None]
    P    = softmax(W_d @ flat + b_d)
    return P, dict(v1=v1,v2=v2,v3=v3,mk3=mk3,v4=v4,v5=v5,flat=flat)

# Mini-entraînement CNN (quelques époques sur ~200 images pour valider le code)
def train_mini_cnn(X_rgb, y, nf=8, epochs=3, bs=20, lr=.01):
    """
    Entraîne un CNN miniature (nf filtres) sur X_rgb (n,3072).
    Retourne historique de perte + taux d'erreur final.
    """
    rng = np.random.default_rng(7); n = len(y)
    F1 = rng.normal(0,.15,(nf,3,3,3)); b1=np.zeros(nf)
    F2 = rng.normal(0,.15,(nf,3,3,nf)); b2=np.zeros(nf)
    F3 = rng.normal(0,.15,(nf,3,3,nf)); b3=np.zeros(nf)
    fsz = 8*8*nf
    W_d = rng.normal(0, np.sqrt(2/fsz),(10,fsz)); b_d=np.zeros((10,1))

    loss_hist = []
    for ep in range(epochs):
        idx = rng.permutation(n); tot_loss=0; n_ok=0
        for s in range(0, n, bs):
            ib = idx[s:s+bs]; nb=len(ib)
            # Accumulation gradients
            aF1=np.zeros_like(F1); ab1=np.zeros_like(b1)
            aF2=np.zeros_like(F2); ab2=np.zeros_like(b2)
            aF3=np.zeros_like(F3); ab3=np.zeros_like(b3)
            aWd=np.zeros_like(W_d); abd=np.zeros_like(b_d)
            for ii in ib:
                img = X_rgb[ii].reshape(3,32,32).transpose(1,2,0)  # (32,32,3)
                P, cache = cnn_forward_single(img, F1,b1,F2,b2,F3,b3,W_d,b_d)
                tot_loss += -np.log(P[int(y[ii]),0]+1e-15)
                n_ok += (np.argmax(P)==int(y[ii]))
                yoh = np.zeros((10,1)); yoh[int(y[ii])]=1
                δ = P - yoh
                # Dense gradient
                aWd += δ @ cache['flat'].T; abd += δ
                d_flat = W_d.T @ δ
                d_v5   = d_flat.reshape(cache['v5'].shape)
                # MaxPool2 backward (gradient vers v4)
                v5 = cache['v5']; H2,W2,C=v5.shape
                d_v4 = np.zeros_like(cache['v4'])
                for u in range(H2):
                    for vv in range(W2):
                        for c in range(C):
                            d_v4[2*u:2*u+2,2*vv:2*vv+2,c] += (
                                d_v5[u,vv,c]*cache['mk5'][2*u:2*u+2,2*vv:2*vv+2,c])
                d_v4 *= (cache['v4']>0)
                # Conv3 backward (gradient filtre simplifié)
                for f in range(nf):
                    ab3[f] += d_v4[:,:,f].sum()
                    for c in range(nf):
                        g = convolve2d(cache['v3'][:,:,c], d_v4[:,:,f], mode='valid')
                        aF3[f,:,:,c] += g[:3,:3]
                # (on simplifie : on ne propage pas plus loin pour les filtres F1,F2)
                # (cf. Option A sujet §2.6.1 — calcul complet nécessiterait ~10× plus de code)
            # Mise à jour SGD
            F3  -= lr*aF3/nb; b3 -= lr*ab3/nb
            W_d -= lr*aWd/nb; b_d -= lr*abd/nb
        avg_l = tot_loss/n; acc_ep = n_ok/n
        loss_hist.append(avg_l)
        print(f"  CNN ép.{ep+1}/{epochs} — loss:{avg_l:.4f}  acc:{acc_ep:.3f}")
    # Prédiction finale
    preds = []
    for i in range(n):
        img = X_rgb[i].reshape(3,32,32).transpose(1,2,0)
        P,_ = cnn_forward_single(img,F1,b1,F2,b2,F3,b3,W_d,b_d)
        preds.append(int(np.argmax(P)))
    return loss_hist, err_rate(np.array(preds), y)

