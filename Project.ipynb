# ─────────────────────────────────────────────────────────────────────────────
#  FONCTIONS MATHÉMATIQUES (poly ch.3-5)
# ─────────────────────────────────────────────────────────────────────────────

def softmax(Z):
    """Softmax stable numériquement : P_k = e^{o_k} / Σ_j e^{o_j}"""
    Z_s = Z - Z.max(axis=0, keepdims=True)
    E   = np.exp(Z_s)
    return E / E.sum(axis=0, keepdims=True)

def cross_entropy(P, Y_oh, eps=1e-15):
    """L = −1/n Σ_i Σ_k y_i^(k) ln P_k(x_i)"""
    return -np.sum(Y_oh * np.log(P + eps)) / P.shape[1]

def to_onehot(y, K=10):
    Y = np.zeros((K, len(y))); Y[y, np.arange(len(y))] = 1; return Y

def relu(Z):       return np.maximum(0, Z)
def relu_p(Z):     return (Z > 0).astype(float)
def tanh_p(Z):     return 1 - np.tanh(Z)**2

def accuracy(yp, yt):    return np.mean(yp == yt)
def err_rate(yp, yt):    return 1 - accuracy(yp, yt)

