                                             stratify=y_med,random_state=0)
Ym_tr=to_onehot(ym_tr,2); Ym_te=to_onehot(ym_te,2)
Xm_tr_T=Xm_tr.T; Xm_te_T=Xm_te.T

print("\n[3.3] Linéaire médical")
lm = ModeleLineaire(200,2)
lm.fit(Xm_tr_T, Ym_tr, lr=.05, epochs=150, bs=64, Xv=Xm_te_T, Yv=Ym_te)
e_lm_tr = err_rate(lm.predict(Xm_tr_T), ym_tr)
e_lm_te = err_rate(lm.predict(Xm_te_T), ym_te)
print(f"  Erreur entr: {e_lm_tr*100:.2f}%  |  test: {e_lm_te*100:.2f}%")

print("\n[3.4] MLP H=1 médical")
mm = MLP([200,64,2])
mm.fit(Xm_tr_T, Ym_tr, lr=.01, epochs=150, bs=64, Xv=Xm_te_T, Yv=Ym_te)
yp_mm = mm.predict(Xm_te_T)
e_mm_tr = err_rate(mm.predict(Xm_tr_T), ym_tr)
e_mm_te = err_rate(yp_mm, ym_te)
print(f"  Erreur entr: {e_mm_tr*100:.2f}%  |  test: {e_mm_te*100:.2f}%")

cm_med = confusion_matrix(ym_te, yp_mm)
TN,FP,FN,TP = cm_med.ravel()
sens = TP/(TP+FN+1e-9); spec = TN/(TN+FP+1e-9)
print(f"  FN (cancers manqués) : {FN}   Sensibilité : {sens:.3f}")

